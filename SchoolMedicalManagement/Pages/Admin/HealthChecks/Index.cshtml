@page
@model SchoolMedicalManagement.Pages.Admin.HealthChecks.IndexModel
@{
    ViewData["Title"] = "Quản lý Kiểm tra Sức khỏe";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-heartbeat me-2"></i>
                        Quản lý Kiểm tra Sức khỏe
                    </h3>
                    <a href="/Admin/HealthChecks/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>
                        Tạo Kiểm tra mới
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.HealthChecks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Học sinh</th>
                                        <th>Ngày kiểm tra</th>
                                        <th>Loại kiểm tra</th>
                                        <th>Kết quả</th>
                                        <th>Ghi chú</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var healthCheck in Model.HealthChecks)
                                    {
                                        <tr>
                                            <td><strong>#@healthCheck.Id</strong></td>
                                            <td>
                                                @if (healthCheck.Student != null)
                                                {
                                                    <span class="badge bg-info">@healthCheck.Student.FullName</span>
                                                    <br><small class="text-muted">@healthCheck.Student.Class</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">ID: @healthCheck.StudentId</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @healthCheck.Date.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@healthCheck.CheckType</span>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (healthCheck.Results.Length > 50)
                                                    {
                                                        @(healthCheck.Results.Substring(0, 50) + "...")
                                                    }
                                                    else
                                                    {
                                                        @healthCheck.Results
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div style="max-width: 150px;">
                                                    @if (!string.IsNullOrEmpty(healthCheck.Notes))
                                                    {
                                                        if (healthCheck.Notes.Length > 30)
                                                        {
                                                            @(healthCheck.Notes.Substring(0, 30) + "...")
                                                        }
                                                        else
                                                        {
                                                            @healthCheck.Notes
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/Admin/HealthChecks/Details/@healthCheck.Id" 
                                                       class="btn btn-sm btn-outline-info" 
                                                       title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Admin/HealthChecks/Edit/@healthCheck.Id" 
                                                       class="btn btn-sm btn-outline-warning" 
                                                       title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="/Admin/HealthChecks/Delete/@healthCheck.Id" 
                                                       class="btn btn-sm btn-outline-danger" 
                                                       title="Xóa">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có kiểm tra sức khỏe nào</h5>
                            <p class="text-muted">Nhấn nút "Tạo Kiểm tra mới" để bắt đầu</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        Tổng cộng: <strong>@Model.HealthChecks.Count()</strong> kiểm tra sức khỏe
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.table td {
    vertical-align: middle;
}
.badge {
    font-size: 0.85em;
}
.btn-group .btn {
    margin: 0 1px;
}
</style> 