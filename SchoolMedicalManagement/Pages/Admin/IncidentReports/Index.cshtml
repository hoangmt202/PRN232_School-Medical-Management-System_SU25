@page
@model SchoolMedicalManagement.Pages.Admin.IncidentReports.IndexModel
@{
    ViewData["Title"] = "Quản lý Báo cáo Sự cố";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Quản lý Báo cáo Sự cố
                    </h3>
                    <a href="/Admin/IncidentReports/Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>
                        Tạo Báo cáo mới
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.IncidentReports.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Học sinh</th>
                                        <th>Y tá</th>
                                        <th>Ngày</th>
                                        <th>Loại sự cố</th>
                                        <th>Mô tả</th>
                                        <th>Hành động</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.IncidentReports)
                                    {
                                        <tr>
                                            <td><strong>#@incident.Id</strong></td>
                                            <td>
                                                @if (incident.Student != null)
                                                {
                                                    <span class="badge bg-info">@incident.Student.FullName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">ID: @incident.StudentId</span>
                                                }
                                            </td>
                                            <td>
                                                @if (incident.Nurse != null)
                                                {
                                                    <span class="badge bg-success">@incident.Nurse.FullName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">ID: @incident.NurseId</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @incident.Date.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning text-dark">@incident.Type</span>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (incident.Description.Length > 50)
                                                    {
                                                        @(incident.Description.Substring(0, 50) + "...")
                                                    }
                                                    else
                                                    {
                                                        @incident.Description
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (incident.ActionTaken.Length > 50)
                                                    {
                                                        @(incident.ActionTaken.Substring(0, 50) + "...")
                                                    }
                                                    else
                                                    {
                                                        @incident.ActionTaken
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/Admin/IncidentReports/Details/@incident.Id" 
                                                       class="btn btn-sm btn-outline-info" 
                                                       title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Admin/IncidentReports/Edit/@incident.Id" 
                                                       class="btn btn-sm btn-outline-warning" 
                                                       title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="/Admin/IncidentReports/Delete/@incident.Id" 
                                                       class="btn btn-sm btn-outline-danger" 
                                                       title="Xóa">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có báo cáo sự cố nào</h5>
                            <p class="text-muted">Nhấn nút "Tạo Báo cáo mới" để bắt đầu</p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        Tổng cộng: <strong>@Model.IncidentReports.Count()</strong> báo cáo sự cố
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.table td {
    vertical-align: middle;
}
.badge {
    font-size: 0.85em;
}
.btn-group .btn {
    margin: 0 1px;
}
</style> 