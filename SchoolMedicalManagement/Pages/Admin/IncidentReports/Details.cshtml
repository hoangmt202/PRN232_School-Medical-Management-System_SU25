@page "{id:int}"
@model SchoolMedicalManagement.Pages.Admin.IncidentReports.DetailsModel
@{
    ViewData["Title"] = "Chi tiết Báo cáo Sự cố";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-file-alt me-2"></i>
                        Chi tiết Báo cáo Sự cố #@Model.IncidentReport.Id
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="text-primary">
                                    <i class="fas fa-user-graduate me-2"></i>
                                    Thông tin Học sinh
                                </h5>
                                <div class="ps-3">
                                    @if (Model.IncidentReport.Student != null)
                                    {
                                        <p><strong>Họ tên:</strong> @Model.IncidentReport.Student.FullName</p>
                                        <p><strong>Lớp:</strong> @Model.IncidentReport.Student.Class</p>
                                        <p><strong>Ngày sinh:</strong> @Model.IncidentReport.Student.DateOfBirth.ToString("dd/MM/yyyy")</p>
                                        <p><strong>Giới tính:</strong> @Model.IncidentReport.Student.Gender</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted">ID Học sinh: @Model.IncidentReport.StudentId</p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="text-success">
                                    <i class="fas fa-user-nurse me-2"></i>
                                    Y tá phụ trách
                                </h5>
                                <div class="ps-3">
                                    @if (Model.IncidentReport.Nurse != null)
                                    {
                                        <p><strong>Họ tên:</strong> @Model.IncidentReport.Nurse.FullName</p>
                                        <p><strong>Số điện thoại:</strong> @Model.IncidentReport.Nurse.PhoneNumber</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted">ID Y tá: @Model.IncidentReport.NurseId</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-calendar me-1"></i>
                                    Ngày/Giờ sự cố:
                                </label>
                                <p class="form-control-plaintext">
                                    @Model.IncidentReport.Date.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-tags me-1"></i>
                                    Loại sự cố:
                                </label>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-warning text-dark fs-6">@Model.IncidentReport.Type</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-file-alt me-1"></i>
                            Mô tả chi tiết sự cố:
                        </label>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p class="mb-0">@Model.IncidentReport.Description</p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-hand-holding-medical me-1"></i>
                            Hành động đã thực hiện:
                        </label>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p class="mb-0">@Model.IncidentReport.ActionTaken</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Admin/IncidentReports/Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Quay lại danh sách
                        </a>
                        <div>
                            <a href="/Admin/IncidentReports/Edit/@Model.IncidentReport.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>
                                Chỉnh sửa
                            </a>
                            <a href="/Admin/IncidentReports/Delete/@Model.IncidentReport.Id" class="btn btn-danger">
                                <i class="fas fa-trash me-2"></i>
                                Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card-header {
    background: linear-gradient(45deg, #17a2b8, #138496);
    color: white;
}
.form-label i {
    color: #17a2b8;
}
.badge {
    font-size: 0.9em;
}
</style> 