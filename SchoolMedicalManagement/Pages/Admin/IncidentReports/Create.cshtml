@page
@model SchoolMedicalManagement.Pages.Admin.IncidentReports.CreateModel
@{
    ViewData["Title"] = "Tạo Báo cáo Sự cố mới";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-plus-circle me-2"></i>
                        Tạo Báo cáo Sự cố mới
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.StudentId" class="form-label">
                                        <i class="fas fa-user-graduate me-1"></i>
                                        Học sinh *
                                    </label>
                                    <select asp-for="IncidentReport.StudentId" class="form-select" required>
                                        <option value="">-- Chọn học sinh --</option>
                                        @foreach (var student in Model.Students)
                                        {
                                            <option value="@student.Id">@student.FullName - @student.Class</option>
                                        }
                                    </select>
                                    <span asp-validation-for="IncidentReport.StudentId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.NurseId" class="form-label">
                                        <i class="fas fa-user-nurse me-1"></i>
                                        Y tá phụ trách *
                                    </label>
                                    <select asp-for="IncidentReport.NurseId" class="form-select" required>
                                        <option value="">-- Chọn y tá --</option>
                                        @foreach (var nurse in Model.Nurses)
                                        {
                                            <option value="@nurse.Id">@nurse.FullName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="IncidentReport.NurseId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Date" class="form-label">
                                        <i class="fas fa-calendar me-1"></i>
                                        Ngày/Giờ sự cố *
                                    </label>
                                    <input asp-for="IncidentReport.Date" type="datetime-local" class="form-control" required />
                                    <span asp-validation-for="IncidentReport.Date" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Type" class="form-label">
                                        <i class="fas fa-tags me-1"></i>
                                        Loại sự cố *
                                    </label>
                                    <select asp-for="IncidentReport.Type" class="form-select" required>
                                        <option value="">-- Chọn loại sự cố --</option>
                                        <option value="Tai nạn">Tai nạn</option>
                                        <option value="Bệnh đột xuất">Bệnh đột xuất</option>
                                        <option value="Chấn thương">Chấn thương</option>
                                        <option value="Dị ứng">Dị ứng</option>
                                        <option value="Khẩn cấp">Khẩn cấp</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="IncidentReport.Type" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.Description" class="form-label">
                                <i class="fas fa-file-alt me-1"></i>
                                Mô tả chi tiết sự cố *
                            </label>
                            <textarea asp-for="IncidentReport.Description" class="form-control" rows="4" 
                                      placeholder="Mô tả chi tiết về sự cố đã xảy ra..." required></textarea>
                            <span asp-validation-for="IncidentReport.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.ActionTaken" class="form-label">
                                <i class="fas fa-hand-holding-medical me-1"></i>
                                Hành động đã thực hiện *
                            </label>
                            <textarea asp-for="IncidentReport.ActionTaken" class="form-control" rows="4" 
                                      placeholder="Mô tả các hành động đã thực hiện để xử lý sự cố..." required></textarea>
                            <span asp-validation-for="IncidentReport.ActionTaken" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Admin/IncidentReports/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>
                                Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>
                                Lưu Báo cáo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card-header {
    background: linear-gradient(45deg, #007bff, #0056b3);
    color: white;
}
.form-label i {
    color: #007bff;
}
.btn-primary {
    background: linear-gradient(45deg, #007bff, #0056b3);
    border: none;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Set default date to current datetime
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const formatted = now.getFullYear() + '-' + 
                            String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                            String(now.getDate()).padStart(2, '0') + 'T' + 
                            String(now.getHours()).padStart(2, '0') + ':' + 
                            String(now.getMinutes()).padStart(2, '0');
            document.querySelector('input[type="datetime-local"]').value = formatted;
        });
    </script>
} 