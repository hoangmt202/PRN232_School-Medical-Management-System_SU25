@page "{id:int}"
@model SchoolMedicalManagement.Pages.Admin.IncidentReports.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa Báo cáo Sự cố";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-edit me-2"></i>
                        Chỉnh sửa Báo cáo Sự cố #@Model.IncidentReportId
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Date" class="form-label">
                                        <i class="fas fa-calendar me-1"></i>
                                        Ngày/Giờ sự cố *
                                    </label>
                                    <input asp-for="IncidentReport.Date" type="datetime-local" class="form-control" required />
                                    <span asp-validation-for="IncidentReport.Date" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Type" class="form-label">
                                        <i class="fas fa-tags me-1"></i>
                                        Loại sự cố *
                                    </label>
                                    <select asp-for="IncidentReport.Type" class="form-select" required>
                                        <option value="">-- Chọn loại sự cố --</option>
                                        <option value="Tai nạn">Tai nạn</option>
                                        <option value="Bệnh đột xuất">Bệnh đột xuất</option>
                                        <option value="Chấn thương">Chấn thương</option>
                                        <option value="Dị ứng">Dị ứng</option>
                                        <option value="Khẩn cấp">Khẩn cấp</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="IncidentReport.Type" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.Description" class="form-label">
                                <i class="fas fa-file-alt me-1"></i>
                                Mô tả chi tiết sự cố *
                            </label>
                            <textarea asp-for="IncidentReport.Description" class="form-control" rows="4" 
                                      placeholder="Mô tả chi tiết về sự cố đã xảy ra..." required></textarea>
                            <span asp-validation-for="IncidentReport.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.ActionTaken" class="form-label">
                                <i class="fas fa-hand-holding-medical me-1"></i>
                                Hành động đã thực hiện *
                            </label>
                            <textarea asp-for="IncidentReport.ActionTaken" class="form-control" rows="4" 
                                      placeholder="Mô tả các hành động đã thực hiện để xử lý sự cố..." required></textarea>
                            <span asp-validation-for="IncidentReport.ActionTaken" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Lưu ý:</strong> Học sinh và Y tá phụ trách không thể thay đổi sau khi tạo báo cáo.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Admin/IncidentReports/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>
                                Quay lại
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>
                                Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card-header {
    background: linear-gradient(45deg, #28a745, #20c997);
    color: white;
}
.form-label i {
    color: #28a745;
}
.btn-success {
    background: linear-gradient(45deg, #28a745, #20c997);
    border: none;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 