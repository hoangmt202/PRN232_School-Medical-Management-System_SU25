@page "{id:int}"
@model SchoolMedicalManagement.Pages.Students.DetailsModel
@{
    ViewData["Title"] = "Student Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-graduation-cap me-2"></i>Student Details
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Full Name:</strong>
                                <p class="form-control-plaintext">@Model.Student.FullName</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Date of Birth:</strong>
                                <p class="form-control-plaintext">@Model.Student.DateOfBirth.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Gender:</strong>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-info">@Model.Student.Gender</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Class:</strong>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-secondary">@Model.Student.Class</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Parent ID:</strong>
                        <p class="form-control-plaintext">@Model.Student.ParentId</p>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.Student.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.Student.Id" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete
                            </a>
                            @if (User.IsInRole("Nurse"))
                            {
                                <a asp-page="/IncidentReports/Create" asp-route-studentId="@Model.Student.Id" class="btn btn-warning ms-2">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Create Incident Report
                                </a>
                                <a asp-page="/HealthChecks/Create" asp-route-studentId="@Model.Student.Id" class="btn btn-info ms-2">
                                    <i class="fas fa-notes-medical me-1"></i>Create Health Check
                                </a>
                            }
                            @if (User.IsInRole("Parent"))
                            {
                                <a asp-page="/IncidentReports/Index" asp-route-studentId="@Model.Student.Id" class="btn btn-outline-primary ms-2">
                                    <i class="fas fa-exclamation-triangle me-1"></i>View Incident Reports
                                </a>
                                <a asp-page="/MedicalRecords/Index" asp-route-studentId="@Model.Student.Id" class="btn btn-outline-success ms-2">
                                    <i class="fas fa-file-medical me-1"></i>View Medical Records
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 