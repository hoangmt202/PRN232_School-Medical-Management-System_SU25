@page
@model SchoolMedicalManagement.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

@if (User.IsInRole("SchoolNurse"))
{
    <style>
        .btn, .action-buttons { display: none !important; }
    </style>
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-graduation-cap me-2"></i>Students Management
                    </h3>
                    <a class="btn btn-light" asp-page="Create">
                        <i class="fas fa-plus me-1"></i>Add New Student
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Students != null && Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="fas fa-user me-1"></i>Full Name</th>
                                        <th><i class="fas fa-calendar me-1"></i>Date of Birth</th>
                                        <th><i class="fas fa-venus-mars me-1"></i>Gender</th>
                                        <th><i class="fas fa-school me-1"></i>Class</th>
                                        <th><i class="fas fa-users me-1"></i>Parent</th>
                                        <th class="text-center"><i class="fas fa-cogs me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@student.FullName</strong>
                                            </td>
                                            <td>@student.DateOfBirth.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-info">@student.Gender</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@student.Class</span>
                                            </td>
                                            <td>@student.ParentId</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-page="Details" asp-route-id="@student.Id" class="btn btn-sm btn-info me-1" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-page="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning me-1" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-page="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Students Found</h4>
                            <p class="text-muted">Start by adding your first student to the system.</p>
                            <a asp-page="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Add First Student
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 