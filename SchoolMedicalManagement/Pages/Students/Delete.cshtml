@page "{id:int}"
@model SchoolMedicalManagement.Pages.Students.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-trash me-2"></i>Delete Student
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> Are you sure you want to delete this student? This action cannot be undone.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Full Name:</strong>
                                <p class="form-control-plaintext">@Model.Student.FullName</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Date of Birth:</strong>
                                <p class="form-control-plaintext">@Model.Student.DateOfBirth.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Gender:</strong>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-info">@Model.Student.Gender</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Class:</strong>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-secondary">@Model.Student.Class</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Parent ID:</strong>
                        <p class="form-control-plaintext">@Model.Student.ParentId</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Student.Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete Student
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 