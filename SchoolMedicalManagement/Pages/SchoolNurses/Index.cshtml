@page
@model SchoolMedicalManagement.Pages.SchoolNurses.IndexModel
@{
    ViewData["Title"] = "School Nurses";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-user-nurse me-2"></i>School Nurses Management
                    </h3>
                    <a class="btn btn-light" asp-page="Create">
                        <i class="fas fa-plus me-1"></i>Add New Nurse
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.SchoolNurses != null && Model.SchoolNurses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="fas fa-user me-1"></i>Full Name</th>
                                        <th><i class="fas fa-phone me-1"></i>Phone Number</th>
                                        <th class="text-center"><i class="fas fa-cogs me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var nurse in Model.SchoolNurses)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@nurse.FullName</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@nurse.PhoneNumber</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-page="Details" asp-route-id="@nurse.Id" class="btn btn-sm btn-info me-1" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-page="Edit" asp-route-id="@nurse.Id" class="btn btn-sm btn-warning me-1" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-page="Delete" asp-route-id="@nurse.Id" class="btn btn-sm btn-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-user-nurse fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No School Nurses Found</h4>
                            <p class="text-muted">Start by adding your first school nurse to the system.</p>
                            <a asp-page="Create" class="btn btn-info">
                                <i class="fas fa-plus me-1"></i>Add First Nurse
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 