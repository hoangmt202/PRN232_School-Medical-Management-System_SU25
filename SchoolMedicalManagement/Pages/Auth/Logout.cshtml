@page
@model SchoolMedicalManagement.Pages.Auth.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark rounded-top-4 text-center">
                    <h4 class="mb-0">
                        <i class="fas fa-sign-out-alt me-2"></i>
                        Đăng xuất thành công
                    </h4>
                </div>
                <div class="card-body text-center p-4">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success fa-3x mb-3"></i>
                        <p class="lead">Bạn đã đăng xuất khỏi hệ thống thành công!</p>
                        <p class="text-muted">Cảm ơn bạn đã sử dụng School Medical Management System.</p>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/Auth/Login" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Đăng nhập lại
                        </a>
                        <a href="/Index" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-2"></i>
                            Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 