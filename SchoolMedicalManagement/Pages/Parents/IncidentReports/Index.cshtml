@page "/parents/incident-reports"
@model SchoolMedicalManagement.Pages.Parents.IncidentReports.IndexModel
@{
    ViewData["Title"] = "Children's Incident Reports";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header Section -->
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-gradient-info text-white border-0 py-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="mb-2 text-white">
                                <i class="fas fa-exclamation-triangle me-3"></i>Children's Incident Reports
                            </h4>
                            <p class="mb-0 text-white-50">
                                View incident reports related to your children
                            </p>
                        </div>
                        <!-- No Add button for parents -->
                    </div>
                </div>
            </div>

            <!-- Alert Messages -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div>
                            <strong>Notice:</strong> @Model.ErrorMessage
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Reports Table -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    @if (Model.IncidentReports.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Student</th>
                                        <th>School Nurse</th>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Action Taken</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.IncidentReports)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary">#@incident.Id</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-primary text-white rounded-circle me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <strong>@incident.Student?.FullName</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-success text-white rounded-circle me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="fas fa-user-nurse"></i>
                                                    </div>
                                                    @incident.Nurse?.FullName
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-muted">
                                                    <i class="far fa-calendar me-1"></i>
                                                    @incident.Date.ToString("dd/MM/yyyy")
                                                </div>
                                                <small class="text-muted">
                                                    <i class="far fa-clock me-1"></i>
                                                    @incident.Date.ToString("HH:mm")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge 
                                                    @(incident.Type == "Tai nạn" ? "bg-danger" : 
                                                      incident.Type == "Đau ốm" ? "bg-warning" : 
                                                      incident.Type == "Khẩn cấp" ? "bg-danger" : "bg-info")">
                                                    @incident.Type
                                                </span>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (incident.Description.Length > 50)
                                                    {
                                                        @(incident.Description.Substring(0, 50) + "...")
                                                    }
                                                    else
                                                    {
                                                        @incident.Description
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (incident.ActionTaken.Length > 50)
                                                    {
                                                        @(incident.ActionTaken.Substring(0, 50) + "...")
                                                    }
                                                    else
                                                    {
                                                        @incident.ActionTaken
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <!-- Only Details button for parents -->
                                                <a href="/Parents/IncidentReports/Details/@incident.Id" 
                                                   class="btn btn-sm btn-outline-info" 
                                                   title="View Details">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-clipboard-list fa-3x text-muted"></i>
                            </div>
                            <h5 class="text-muted mb-3">No Incident Reports</h5>
                            <p class="text-muted">Currently there are no incident reports for your children.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 