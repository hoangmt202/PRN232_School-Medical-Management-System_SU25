@page "/parents/incident-reports/details/{id:int}"
@model SchoolMedicalManagement.Pages.Parents.IncidentReports.DetailsModel
@{
    ViewData["Title"] = "Incident Report Details";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <!-- Header Section -->
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-gradient-info text-white border-0 py-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="mb-2 text-white">
                                <i class="fas fa-file-alt me-3"></i>Incident Report Details
                            </h4>
                            <p class="mb-0 text-white-50">
                                Report ID: <strong>#@Model.IncidentReport.Id</strong>
                            </p>
                        </div>
                        <div class="col-auto">
                            <a href="/parents/incident-reports" class="btn btn-outline-light btn-sm">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alert Messages -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div>
                            <strong>Error:</strong> @Model.ErrorMessage
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.IncidentReport != null)
            {
                <!-- Main Details Card -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light border-bottom">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2 text-info"></i>Incident Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted">Student:</label>
                                <div class="d-flex align-items-center">
                                    <div class="avatar bg-primary text-white rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@Model.IncidentReport.Student?.FullName</h6>
                                        <small class="text-muted">ID: @Model.IncidentReport.StudentId</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted">Nurse in Charge:</label>
                                <div class="d-flex align-items-center">
                                    <div class="avatar bg-success text-white rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-user-nurse"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@Model.IncidentReport.Nurse?.FullName</h6>
                                        <small class="text-muted">ID: @Model.IncidentReport.NurseId</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted">Date of Incident:</label>
                                <div class="bg-light p-2 rounded">
                                    <i class="far fa-calendar-alt me-2 text-primary"></i>
                                    @Model.IncidentReport.Date.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted">Incident Type:</label>
                                <div>
                                    <span class="badge fs-6 
                                        @(Model.IncidentReport.Type == "Tai nạn" ? "bg-danger" : 
                                          Model.IncidentReport.Type == "Đau ốm" ? "bg-warning" : 
                                          Model.IncidentReport.Type == "Khẩn cấp" ? "bg-danger" : "bg-info")">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        @Model.IncidentReport.Type
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Incident Description:</label>
                            <div class="bg-light p-3 rounded border">
                                <p class="mb-0">@Model.IncidentReport.Description</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Actions Taken:</label>
                            <div class="bg-success bg-opacity-10 p-3 rounded border border-success border-opacity-25">
                                <p class="mb-0">@Model.IncidentReport.ActionTaken</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="d-flex justify-content-between">
                    <a href="/parents/incident-reports" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <!-- No Edit/Delete buttons for parents -->
                </div>
            }
        </div>
    </div>
</div> 