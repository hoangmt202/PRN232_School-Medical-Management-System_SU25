@page "/parents/health-checks"
@model SchoolMedicalManagement.Pages.Parents.HealthChecks.IndexModel
@{
    ViewData["Title"] = "Children's Health Checks";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header Section -->
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-gradient-success text-white border-0 py-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="mb-2 text-white">
                                <i class="fas fa-heartbeat me-3"></i>Children's Health Checks
                            </h4>
                            <p class="mb-0 text-white-50">
                                Monitor your children's health check results
                            </p>
                        </div>
                        <!-- No Add button for parents -->
                    </div>
                </div>
            </div>

            <!-- Debug Information -->
            @if (!string.IsNullOrEmpty(Model.DebugInfo))
            {
                <div class="alert alert-info">
                    <h5>Debug Information:</h5>
                    <pre style="white-space: pre-wrap; font-size: 12px;">@Model.DebugInfo</pre>
                </div>
            }

            <!-- Alert Messages -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div>
                            <strong>Notice:</strong> @Model.ErrorMessage
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Health Checks Table -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    @if (Model.HealthChecks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Student</th>
                                        <th>Date</th>
                                        <th>Check Type</th>
                                        <th>Results</th>
                                        <th>Notes</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var healthCheck in Model.HealthChecks)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary">#@healthCheck.Id</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar avatar-sm bg-gradient-primary rounded-circle text-white d-flex align-items-center justify-content-center me-2">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 text-sm">@(healthCheck.Student?.FullName ?? "Unknown Student")</h6>
                                                        <p class="text-xs text-secondary mb-0">
                                                            @if (healthCheck.Student != null)
                                                            {
                                                                @healthCheck.Student.Class
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-secondary text-xs">
                                                    @healthCheck.Date.ToString("MMM dd, yyyy")
                                                </span>
                                                <br>
                                                <span class="text-xs">
                                                    @healthCheck.Date.ToString("HH:mm")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@healthCheck.CheckType</span>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (!string.IsNullOrEmpty(healthCheck.Results))
                                                    {
                                                        @if (healthCheck.Results.Length > 50)
                                                        {
                                                            @(healthCheck.Results.Substring(0, 50) + "...")
                                                        }
                                                        else
                                                        {
                                                            @healthCheck.Results
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div style="max-width: 200px;">
                                                    @if (!string.IsNullOrEmpty(healthCheck.Notes))
                                                    {
                                                        @if (healthCheck.Notes.Length > 30)
                                                        {
                                                            @(healthCheck.Notes.Substring(0, 30) + "...")
                                                        }
                                                        else
                                                        {
                                                            @healthCheck.Notes
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <!-- Only Details button for parents -->
                                                <a href="/Parents/HealthChecks/Details/@healthCheck.Id" 
                                                   class="btn btn-sm btn-outline-success" 
                                                   title="View Details">
                                                    <i class="fas fa-eye me-1"></i>
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="d-flex justify-content-center mb-4">
                                <div class="avatar avatar-xl bg-gradient-secondary rounded-circle text-white d-flex align-items-center justify-content-center">
                                    <i class="fas fa-heartbeat fa-2x text-white"></i>
                                </div>
                            </div>
                            <h5 class="text-muted">No Health Check Results</h5>
                            <p class="text-muted mb-0">Currently there are no health check results for your children.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 