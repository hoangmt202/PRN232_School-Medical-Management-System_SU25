@page "{id:int}"
@model SchoolMedicalManagement.Pages.IncidentReports.DetailsModel
@{
    ViewData["Title"] = "Incident Report Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Incident Report Details
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Student:</strong>
                                <p class="form-control-plaintext">@Model.IncidentReport.Student?.FullName</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Nurse:</strong>
                                <p class="form-control-plaintext">@Model.IncidentReport.Nurse?.FullName</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Date & Time:</strong>
                                <p class="form-control-plaintext">@Model.IncidentReport.Date.ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Incident Type:</strong>
                                <p class="form-control-plaintext">
                                    <span class="badge bg-warning text-dark">@Model.IncidentReport.Type</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p class="form-control-plaintext">@Model.IncidentReport.Description</p>
                    </div>

                    <div class="mb-3">
                        <strong>Action Taken:</strong>
                        <p class="form-control-plaintext">@Model.IncidentReport.ActionTaken</p>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.IncidentReport.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.IncidentReport.Id" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 