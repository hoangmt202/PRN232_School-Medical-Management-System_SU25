@page
@model SchoolMedicalManagement.Pages.IncidentReports.IndexModel
@{
    ViewData["Title"] = "Incident Report Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Incident Report Management
                    </h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4>All Incident Reports</h4>
                        <a asp-page="Create" class="btn btn-success">
                            <i class="fas fa-plus me-1"></i>Add New Incident Report
                        </a>
                    </div>

                    @if (Model.IncidentReports != null && Model.IncidentReports.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Student</th>
                                        <th>Nurse</th>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Action Taken</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.IncidentReports)
                                    {
                                        <tr>
                                            <td>@incident.Id</td>
                                            <td>@incident.Student?.FullName</td>
                                            <td>@incident.Nurse?.FullName</td>
                                            <td>@incident.Date.ToString("MMM dd, yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-warning text-dark">@incident.Type</span>
                                            </td>
                                            <td>
                                                @if (incident.Description.Length > 50)
                                                {
                                                    @(incident.Description.Substring(0, 50) + "...")
                                                }
                                                else
                                                {
                                                    @incident.Description
                                                }
                                            </td>
                                            <td>
                                                @if (incident.ActionTaken.Length > 50)
                                                {
                                                    @(incident.ActionTaken.Substring(0, 50) + "...")
                                                }
                                                else
                                                {
                                                    @incident.ActionTaken
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-page="./Details" asp-route-id="@incident.Id" class="btn btn-info btn-sm">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-page="./Edit" asp-route-id="@incident.Id" class="btn btn-warning btn-sm">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-page="./Delete" asp-route-id="@incident.Id" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            No incident reports found. Click "Add New Incident Report" to create the first incident report.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 