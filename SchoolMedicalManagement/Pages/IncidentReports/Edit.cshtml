@page "{id:int}"
@model SchoolMedicalManagement.Pages.IncidentReports.EditModel
@{
    ViewData["Title"] = "Edit Incident Report";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Edit Incident Report
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="IncidentReport.Id" />
                        <input type="hidden" asp-for="IncidentReport.StudentId" />
                        <input type="hidden" asp-for="IncidentReport.NurseId" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Student</label>
                                    <input value="@Model.StudentName" class="form-control" readonly />
                                    <small class="form-text text-muted">Student cannot be changed</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Nurse</label>
                                    <input value="@Model.NurseName" class="form-control" readonly />
                                    <small class="form-text text-muted">Nurse cannot be changed</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Date" class="form-label">Date & Time</label>
                                    <input asp-for="IncidentReport.Date" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="IncidentReport.Date" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IncidentReport.Type" class="form-label">Incident Type</label>
                                    <select asp-for="IncidentReport.Type" class="form-select">
                                        <option value="">-- Select Type --</option>
                                        <option value="Injury">Injury</option>
                                        <option value="Illness">Illness</option>
                                        <option value="Allergic Reaction">Allergic Reaction</option>
                                        <option value="Behavioral">Behavioral</option>
                                        <option value="Medical Emergency">Medical Emergency</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <span asp-validation-for="IncidentReport.Type" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.Description" class="form-label">Description</label>
                            <textarea asp-for="IncidentReport.Description" class="form-control" rows="4" placeholder="Describe the incident in detail"></textarea>
                            <span asp-validation-for="IncidentReport.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IncidentReport.ActionTaken" class="form-label">Action Taken</label>
                            <textarea asp-for="IncidentReport.ActionTaken" class="form-control" rows="4" placeholder="Describe the actions taken to address the incident"></textarea>
                            <span asp-validation-for="IncidentReport.ActionTaken" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-1"></i>Update Incident Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 