@page
@model SchoolMedicalManagement.Pages.MedicalRecords.MyChildrenModel
@{
    ViewData["Title"] = "My Children";
}

<div class="container py-4">
    <h2 class="mb-4">My Children</h2>
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Children == null || !Model.Children.Any())
    {
        <div class="alert alert-info">You have no children registered.</div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Class</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var child in Model.Children)
                {
                    <tr>
                        <td>@child.FullName</td>
                        <td>@child.DateOfBirth.ToShortDateString()</td>
                        <td>@child.Gender</td>
                        <td>@child.Class</td>
                        <td>
                            <a class="btn btn-sm btn-info" href="/Students/Details/@child.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div> 